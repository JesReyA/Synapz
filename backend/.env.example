GEMINI_API_KEY=gemini
GEMINI_MODEL=gemini
# PostgreSQL de Foundathyon (todo acceso a datos pasa por este backend)
DATABASE_URL=postgresql://usuario:contrasena@host:5432/basedatos
# Validación del token de sesión de Foundathyon
FOUNDATHYON_JWT_SECRET=secreto-de-firma
FOUNDATHYON_JWT_ALGORITHM=HS256
# Supabase: solo Storage (buckets materials y reading-audio)
SUPABASE_URL=https://proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key